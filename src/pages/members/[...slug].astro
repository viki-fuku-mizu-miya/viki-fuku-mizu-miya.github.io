---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
	const members = await getCollection('members');
	return members.map((member) => ({ params: { slug: member.id }, props: member }));
}

type Props = CollectionEntry<'members'>;
const member = Astro.props;
const { Content } = await render(member);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`${member.data.name} | ○○研究室`} description={member.data.researchTheme} />
	</head>
	<body>
		<Header />
		<main>
			<a class="back" href="/#members">← メンバー一覧</a>
			<header class="profile-head">
				<div class="portrait" aria-hidden="true"><span>{member.data.initials}</span><i></i></div>
				<div class="profile-copy">
					<p class="role">{member.data.role}</p>
					<h1>{member.data.name}</h1>
					<p class="name-en">{member.data.nameEn}</p>
					<div class="keywords">
						{member.data.keywords.map((keyword) => <span>#{keyword}</span>)}
					</div>
				</div>
			</header>

			<article>
				<aside>
					<p>RESEARCH THEME</p>
					<h2>{member.data.researchTheme}</h2>
				</aside>
				<div class="prose"><Content /></div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { padding: 3rem 0 8rem; }
	.back { color: var(--muted); font-size: .75rem; font-weight: 700; text-decoration: none; }
	.profile-head { display: grid; grid-template-columns: minmax(280px, 430px) 1fr; align-items: center; gap: clamp(3rem, 8vw, 8rem); padding: 3rem 0 7rem; }
	.portrait { position: relative; display: grid; aspect-ratio: 1 / .85; place-items: center; overflow: hidden; background: #dce8e5; }
	.portrait span { z-index: 1; color: rgba(255,255,255,.9); font: italic clamp(5rem, 11vw, 9rem) Georgia, serif; }
	.portrait i { position: absolute; width: 70%; aspect-ratio: 1; border: 1px solid rgba(255,255,255,.8); border-radius: 50%; transform: translate(30%, 25%); }
	.role, .name-en { color: var(--muted); font-size: .72rem; letter-spacing: .12em; }
	h1 { margin: .5rem 0 0; font-size: clamp(3rem, 7vw, 6rem); letter-spacing: -.06em; }
	.name-en { margin-top: 0; }
	.keywords { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 2.25rem; }
	.keywords span { padding: .35rem .7rem; border: 1px solid var(--line); border-radius: 2rem; color: var(--teal); font-size: .72rem; }
	article { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 8vw, 8rem); padding-top: 6rem; border-top: 1px solid var(--line); }
	aside > p { color: var(--coral); font-size: .7rem; font-weight: 700; letter-spacing: .18em; }
	aside h2 { margin-top: 1.25rem; font-size: clamp(1.8rem, 3.2vw, 2.8rem); letter-spacing: -.04em; }
	.prose :global(h2) { margin: 0 0 1.25rem; font-size: 1.4rem; }
	.prose :global(h2:not(:first-child)) { margin-top: 3rem; }
	.prose :global(p) { color: var(--muted); font-size: .95rem; line-height: 2; }
	.prose :global(ul) { padding-left: 1.25rem; color: var(--muted); font-size: .95rem; line-height: 2; }
	@media (max-width: 760px) { .profile-head, article { grid-template-columns: 1fr; gap: 2.5rem; } .profile-head { padding-bottom: 4rem; } article { padding-top: 4rem; } .portrait { max-width: 430px; } }
</style>
