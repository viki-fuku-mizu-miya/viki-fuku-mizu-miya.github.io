---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const members = (await getCollection("members")).sort(
    (a, b) => a.data.order - b.data.order,
);
---

<!doctype html>
<html lang="ja">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <main>
            <section class="hero" aria-labelledby="hero-title">
                <div class="hero-copy">
                    <h1 class="eyebrow">研究室名</h1>
                    <p class="lead">研究室の説明</p>
                    <a class="hero-link" href="#members"
                        >メンバーの研究を見る <span aria-hidden="true">↓</span
                        ></a
                    >
                </div>
                <div class="hero-visual" aria-hidden="true">
                    <div class="orbit orbit-one"></div>
                    <div class="orbit orbit-two"></div>
                    <div class="core">Q</div>
                    <span class="node node-one"></span>
                    <span class="node node-two"></span>
                    <span class="node node-three"></span>
                </div>
            </section>

            <section class="intro" aria-labelledby="about-title">
                <p class="section-number">01</p>
                <div>
                    <p class="eyebrow">ABOUT US</p>
                    <h2 id="about-title">タイトル</h2>
                </div>
                <p>細かい説明</p>
            </section>

            <section
                class="members"
                id="members"
                aria-labelledby="members-title"
            >
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">MEMBERS & RESEARCH</p>
                        <h2 id="members-title">研究紹介</h2>
                    </div>
                    <p>{members.length} MEMBERS</p>
                </div>

                <div class="member-grid">
                    {
                        members.map((member, index) => (
                            <a
                                class={`member-card card-${(index % 3) + 1}`}
                                href={`/members/${member.id}/`}
                            >
                                <div class="portrait" aria-hidden="true">
                                    <span>{member.data.initials}</span>
                                    <i />
                                </div>
                                <div class="card-body">
                                    <p class="role">{member.data.role}</p>
                                    <h3>{member.data.name}</h3>
                                    <p class="name-en">{member.data.nameEn}</p>
                                    <p class="theme">
                                        {member.data.researchTheme}
                                    </p>
                                    <span class="more">
                                        研究を見る <b aria-hidden="true">↗</b>
                                    </span>
                                </div>
                            </a>
                        ))
                    }
                </div>
            </section>

            <section class="question" aria-labelledby="question-title">
                <div>
                    <p class="eyebrow">FOR VISITORS</p>
                    <h2 id="question-title">
                        研究室について<br />もう少し知りたい方へ
                    </h2>
                </div>
                <a href="/faq/"
                    >よくある質問を見る <span aria-hidden="true">→</span></a
                >
            </section>
        </main>
        <Footer />
    </body>
</html>

<style>
    main {
        max-width: 1180px;
        width: calc(100% - 48px);
        padding: 0;
    }
    .hero {
        min-height: 620px;
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        align-items: center;
        gap: 3rem;
        padding: 5rem 0 6rem;
    }
    .eyebrow {
        margin: 0 0 1.25rem;
        color: var(--teal);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.2em;
    }
    .hero h1 {
        max-width: 720px;
        margin: 0;
        font-size: clamp(4rem, 8vw, 7.4rem);
        letter-spacing: -0.07em;
        line-height: 0.92;
    }
    .hero h1 span {
        color: var(--teal);
    }
    .lead {
        max-width: 620px;
        margin: 2.25rem 0;
        color: var(--muted);
        font-size: 1rem;
        line-height: 2;
    }
    .hero-link {
        display: inline-flex;
        gap: 1rem;
        align-items: center;
        color: var(--ink);
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
        border-bottom: 1px solid var(--ink);
        padding-bottom: 0.45rem;
    }
    .hero-visual {
        position: relative;
        aspect-ratio: 1;
        max-width: 420px;
        margin-left: auto;
    }
    .orbit {
        position: absolute;
        inset: 10%;
        border: 1px solid rgba(26, 104, 115, 0.3);
        border-radius: 50%;
    }
    .orbit-two {
        inset: 24%;
        border-style: dashed;
    }
    .core {
        position: absolute;
        inset: 37%;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--ink);
        color: white;
        font-family: Georgia, serif;
        font-size: 4rem;
        font-style: italic;
    }
    .node {
        position: absolute;
        width: 18px;
        aspect-ratio: 1;
        border-radius: 50%;
        background: var(--coral);
        box-shadow: 0 0 0 9px var(--paper);
    }
    .node-one {
        top: 8%;
        left: 46%;
    }
    .node-two {
        right: 8%;
        bottom: 30%;
        background: var(--teal);
    }
    .node-three {
        left: 20%;
        bottom: 15%;
        background: var(--gold);
    }
    .intro {
        display: grid;
        grid-template-columns: 60px 1fr 1fr;
        gap: 3rem;
        padding: 7rem 0;
        border-top: 1px solid var(--line);
    }
    .section-number {
        margin: 0.2rem 0;
        font:
            italic 1rem Georgia,
            serif;
        color: var(--coral);
    }
    .intro h2,
    .section-heading h2,
    .question h2 {
        margin: 0;
        font-size: clamp(2.2rem, 4.2vw, 4rem);
        letter-spacing: -0.05em;
        line-height: 1.2;
    }
    .intro > p:last-child {
        margin: 2.4rem 0 0;
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 2;
    }
    .members {
        padding: 7rem 0;
        border-top: 1px solid var(--line);
        scroll-margin-top: 80px;
    }
    .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 2rem;
        margin-bottom: 3rem;
    }
    .section-heading > p {
        color: var(--muted);
        font-size: 0.7rem;
        letter-spacing: 0.12em;
    }
    .member-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
    }
    .member-card {
        overflow: hidden;
        color: var(--ink);
        text-decoration: none;
        border: 1px solid var(--line);
        border-radius: 3px;
        background: white;
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease;
    }
    .member-card:hover {
        color: var(--ink);
        transform: translateY(-6px);
        box-shadow: 0 18px 50px rgba(31, 48, 50, 0.11);
    }
    .portrait {
        position: relative;
        display: grid;
        min-height: 280px;
        place-items: center;
        overflow: hidden;
        background: #dce8e5;
    }
    .card-2 .portrait {
        background: #f2dfd8;
    }
    .card-3 .portrait {
        background: #e8e4cf;
    }
    .portrait span {
        z-index: 1;
        color: rgba(255, 255, 255, 0.85);
        font:
            italic clamp(4rem, 9vw, 7rem) Georgia,
            serif;
    }
    .portrait i {
        position: absolute;
        width: 72%;
        aspect-ratio: 1;
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 50%;
        transform: translate(28%, 28%);
    }
    .card-body {
        padding: 1.6rem;
    }
    .role,
    .name-en {
        color: var(--muted);
        font-size: 0.7rem;
        letter-spacing: 0.08em;
    }
    .card-body h3 {
        margin: 0.4rem 0 0;
        font-size: 1.45rem;
    }
    .name-en {
        margin-top: 0.1rem;
    }
    .theme {
        min-height: 3.5rem;
        margin: 1.6rem 0;
        font-size: 0.9rem;
        line-height: 1.7;
    }
    .more {
        display: flex;
        justify-content: space-between;
        padding-top: 1rem;
        border-top: 1px solid var(--line);
        font-size: 0.8rem;
        font-weight: 700;
    }
    .question {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 2rem;
        margin-bottom: 7rem;
        padding: 4.5rem;
        background: var(--ink);
        color: white;
    }
    .question h2 {
        color: white;
    }
    .question a {
        flex: 0 0 auto;
        padding: 1rem 1.25rem;
        color: white;
        font-size: 0.85rem;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.4);
    }
    .question a span {
        margin-left: 1.5rem;
    }
    @media (max-width: 800px) {
        main {
            width: calc(100% - 32px);
        }
        .hero {
            min-height: auto;
            grid-template-columns: 1fr;
            padding: 4rem 0;
        }
        .hero-visual {
            display: none;
        }
        .hero h1 {
            font-size: clamp(3.5rem, 17vw, 5.5rem);
        }
        .intro {
            grid-template-columns: 35px 1fr;
            gap: 1.25rem;
            padding: 4.5rem 0;
        }
        .intro > p:last-child {
            grid-column: 2;
            margin-top: 0;
        }
        .members {
            padding: 4.5rem 0;
        }
        .member-grid {
            grid-template-columns: 1fr;
        }
        .portrait {
            min-height: 220px;
        }
        .question {
            align-items: start;
            flex-direction: column;
            margin-bottom: 4rem;
            padding: 2rem;
        }
    }
</style>
