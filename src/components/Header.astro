---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header>
    <nav aria-label="メインナビゲーション">
        <a class="brand" href="/" aria-label={`${SITE_TITLE} トップページ`}>
            <span class="brand-mark" aria-hidden="true"
                ><i></i><i></i><i></i></span
            >
            <span>{SITE_TITLE}</span>
        </a>
        <div class="internal-links">
            <HeaderLink href="/">トップ</HeaderLink>
            <HeaderLink href="/faq/">よくある質問</HeaderLink>
        </div>
    </nav>
</header>

<style>
    header {
        position: sticky;
        z-index: 10;
        top: 0;
        border-bottom: 1px solid var(--line);
        background: rgba(247, 246, 241, 0.92);
        backdrop-filter: blur(12px);
    }
    nav {
        max-width: 1180px;
        height: 74px;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .brand {
        display: flex;
        gap: 0.8rem;
        align-items: center;
        color: var(--ink);
        font-size: 0.86rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-decoration: none;
    }
    .brand-mark {
        position: relative;
        width: 30px;
        height: 24px;
        display: block;
    }
    .brand-mark i {
        position: absolute;
        width: 13px;
        aspect-ratio: 1;
        border: 1.5px solid var(--teal);
        border-radius: 50%;
    }
    .brand-mark i:nth-child(1) {
        left: 0;
        top: 5px;
    }
    .brand-mark i:nth-child(2) {
        left: 9px;
        top: 0;
    }
    .brand-mark i:nth-child(3) {
        left: 16px;
        top: 9px;
        background: var(--coral);
        border-color: var(--coral);
    }
    .internal-links {
        display: flex;
        gap: 2rem;
        align-items: center;
    }
    @media (max-width: 520px) {
        nav {
            height: 64px;
            padding: 0 16px;
        }
        .brand {
            font-size: 0.72rem;
        }
        .internal-links {
            gap: 1rem;
        }
    }
</style>
