---
import { SITE_TITLE } from "../consts";
const today = new Date();
---

<footer>
    <div>
        <a href="/">{SITE_TITLE}</a>
    </div>
    <p class="copyright">&copy; {today.getFullYear()} {SITE_TITLE}</p>
</footer>

<style>
    footer {
        max-width: 1180px;
        margin: 0 auto;
        padding: 3rem 24px 4rem;
        display: flex;
        justify-content: space-between;
        align-items: end;
        border-top: 1px solid var(--line);
    }
    footer a {
        color: var(--ink);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-decoration: none;
    }
    footer p {
        margin: 0.5rem 0 0;
        color: var(--muted);
        font-size: 0.72rem;
    }
    @media (max-width: 600px) {
        footer {
            align-items: start;
            flex-direction: column;
            gap: 2rem;
            padding-inline: 16px;
        }
    }
</style>
